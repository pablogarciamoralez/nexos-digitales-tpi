      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Fin2" bpmnElement="L_Fin2" isHorizontal="true">
        <dc:Bounds x="74" y="132" width="1696" height="205"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Sis2" bpmnElement="L_Sis2" isHorizontal="true">
        <dc:Bounds x="74" y="337" width="1696" height="233"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_InicioPago" bpmnElement="S_InicioPago">
        <dc:Bounds x="146" y="214" width="46" height="46"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Obligacion" bpmnElement="T_Obligacion">
        <dc:Bounds x="264" y="198" width="145" height="75"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Validar" bpmnElement="T_Validar">
        <dc:Bounds x="481" y="420" width="148" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_Validez" bpmnElement="G_Validez">
        <dc:Bounds x="686" y="434" width="54" height="54"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_CorrPago" bpmnElement="T_CorrPago">
        <dc:Bounds x="673" y="196" width="145" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Programar" bpmnElement="T_Programar">
        <dc:Bounds x="862" y="198" width="140" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Banco" bpmnElement="T_Banco">
        <dc:Bounds x="1071" y="421" width="143" height="78"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_Banco" bpmnElement="G_Banco">
        <dc:Bounds x="1274" y="432" width="56" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ErrorBanco" bpmnElement="T_ErrorBanco">
        <dc:Bounds x="1324" y="201" width="142" height="75"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_E_Pendiente" bpmnElement="E_Pendiente">
        <dc:Bounds x="1490" y="215" width="46" height="46"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_Pago" bpmnElement="T_Pago">
        <dc:Bounds x="1437" y="422" width="144" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_E_Pago" bpmnElement="E_Pago">
        <dc:Bounds x="1660" y="440" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F2_1" bpmnElement="F2_1">
        <di:waypoint x="192" y="237"/>
        <di:waypoint x="264" y="237"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F2_2" bpmnElement="F2_2">
        <di:waypoint x="409" y="233"/>
        <di:waypoint x="446" y="233"/>
        <di:waypoint x="446" y="460"/>
        <di:waypoint x="481" y="460"/>
