<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cuentas_por_pagar" targetNamespace="https://nexos-digitales.example/academic/bpmn">
  <bpmn:collaboration id="Collaboration_cuentas_por_pagar">
    <bpmn:participant id="P_Proveedor" name="Proveedor"/>
    <bpmn:participant id="P_Nexos2" name="Nexos Digitales S.R.L." processRef="Process_cuentas_por_pagar"/>
    <bpmn:participant id="P_Banco2" name="Entidad bancaria"/>
    <bpmn:messageFlow id="M2_Proveedor" name="Comprobante" sourceRef="P_Proveedor" targetRef="S_InicioPago"/>
    <bpmn:messageFlow id="M2_BancoReq" name="Orden" sourceRef="T_Banco" targetRef="P_Banco2"/>
    <bpmn:messageFlow id="M2_BancoResp" name="Confirmación" sourceRef="P_Banco2" targetRef="T_Banco"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_cuentas_por_pagar" isExecutable="false" name="BPMN 2.0 - Registro y pago de obligaciones a proveedores">
    <bpmn:laneSet id="LaneSet_cuentas_por_pagar">
      <bpmn:lane id="L_Fin2" name="Finanzas y Control">
        <bpmn:flowNodeRef>S_InicioPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Obligacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CorrPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Programar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ErrorBanco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Pendiente</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sis2" name="Sistema (automático)">
        <bpmn:flowNodeRef>T_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Validez</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Banco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Banco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Pago</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_InicioPago" name="Obligación recibida">
      <bpmn:outgoing>F2_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Obligacion" name="Registrar obligación y vencimiento">
      <bpmn:incoming>F2_1</bpmn:incoming>
      <bpmn:outgoing>F2_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Validar" name="Verificar proveedor, importe y saldo">
      <bpmn:incoming>F2_2</bpmn:incoming>
      <bpmn:incoming>F2_5</bpmn:incoming>
      <bpmn:outgoing>F2_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Validez" name="¿Datos válidos?">
      <bpmn:incoming>F2_3</bpmn:incoming>
      <bpmn:outgoing>F2_4</bpmn:outgoing>
      <bpmn:outgoing>F2_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_CorrPago" name="Corregir datos faltantes">
      <bpmn:incoming>F2_4</bpmn:incoming>
      <bpmn:outgoing>F2_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Programar" name="Autorizar y programar pago">
      <bpmn:incoming>F2_6</bpmn:incoming>
      <bpmn:outgoing>F2_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Banco" name="Enviar instrucción al banco">
      <bpmn:incoming>F2_7</bpmn:incoming>
      <bpmn:outgoing>F2_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Banco" name="¿Confirmado?">
      <bpmn:incoming>F2_8</bpmn:incoming>
      <bpmn:outgoing>F2_9</bpmn:outgoing>
      <bpmn:outgoing>F2_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_ErrorBanco" name="Analizar pago rechazado">
      <bpmn:incoming>F2_9</bpmn:incoming>
      <bpmn:outgoing>F2_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Pendiente" name="Pago pendiente">
      <bpmn:incoming>F2_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_Pago" name="Registrar pago y recalcular saldo">
      <bpmn:incoming>F2_11</bpmn:incoming>
      <bpmn:outgoing>F2_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Pago" name="Obligación actualizada">
      <bpmn:incoming>F2_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F2_1" sourceRef="S_InicioPago" targetRef="T_Obligacion"/>
    <bpmn:sequenceFlow id="F2_2" sourceRef="T_Obligacion" targetRef="T_Validar"/>
    <bpmn:sequenceFlow id="F2_3" sourceRef="T_Validar" targetRef="G_Validez"/>
    <bpmn:sequenceFlow id="F2_4" sourceRef="G_Validez" targetRef="T_CorrPago" name="No"/>
    <bpmn:sequenceFlow id="F2_5" sourceRef="T_CorrPago" targetRef="T_Validar"/>
    <bpmn:sequenceFlow id="F2_6" sourceRef="G_Validez" targetRef="T_Programar" name="Sí"/>
    <bpmn:sequenceFlow id="F2_7" sourceRef="T_Programar" targetRef="T_Banco"/>
    <bpmn:sequenceFlow id="F2_8" sourceRef="T_Banco" targetRef="G_Banco"/>
    <bpmn:sequenceFlow id="F2_9" sourceRef="G_Banco" targetRef="T_ErrorBanco" name="No"/>
    <bpmn:sequenceFlow id="F2_10" sourceRef="T_ErrorBanco" targetRef="E_Pendiente"/>
    <bpmn:sequenceFlow id="F2_11" sourceRef="G_Banco" targetRef="T_Pago" name="Sí"/>
    <bpmn:sequenceFlow id="F2_12" sourceRef="T_Pago" targetRef="E_Pago"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_cuentas_por_pagar">
    <bpmndi:BPMNPlane id="Plane_cuentas_por_pagar" bpmnElement="Collaboration_cuentas_por_pagar">
      <bpmndi:BPMNShape id="Shape_P_Proveedor" bpmnElement="P_Proveedor" isHorizontal="true">
        <dc:Bounds x="35" y="45" width="1735" height="62"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Nexos2" bpmnElement="P_Nexos2" isHorizontal="true">
        <dc:Bounds x="35" y="132" width="1735" height="438"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Banco2" bpmnElement="P_Banco2" isHorizontal="true">
