<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_facturacion_cobranzas" targetNamespace="https://nexos-digitales.example/academic/bpmn">
  <bpmn:collaboration id="Collaboration_facturacion_cobranzas">
    <bpmn:participant id="P_Cliente" name="Cliente"/>
    <bpmn:participant id="P_Nexos" name="Nexos Digitales S.R.L." processRef="Process_facturacion_cobranzas"/>
    <bpmn:participant id="P_ARCA" name="ARCA"/>
    <bpmn:participant id="P_Banco" name="Entidad bancaria"/>
    <bpmn:messageFlow id="M_Cliente" name="Solicitud" sourceRef="P_Cliente" targetRef="S_Inicio"/>
    <bpmn:messageFlow id="M_ARCA_Req" name="Solicitud fiscal" sourceRef="T_Arca" targetRef="P_ARCA"/>
    <bpmn:messageFlow id="M_ARCA_Resp" name="Respuesta ARCA" sourceRef="P_ARCA" targetRef="T_Arca"/>
    <bpmn:messageFlow id="M_Banco" name="Movimiento bancario" sourceRef="P_Banco" targetRef="I_Cobro"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_facturacion_cobranzas" isExecutable="false" name="BPMN 2.0 - Facturación electrónica y aplicación de cobranzas">
    <bpmn:laneSet id="LaneSet_facturacion_cobranzas">
      <bpmn:lane id="L_Comercial" name="Comercialización">
        <bpmn:flowNodeRef>S_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ajustar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Diferencia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Finanzas" name="Finanzas y Control">
        <bpmn:flowNodeRef>T_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Cobro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidarCobro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Cobro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sistema" name="Sistema (automático)">
        <bpmn:flowNodeRef>T_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Arca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Arca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegistrarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Saldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Inicio" name="Solicitud de factura">
      <bpmn:outgoing>F_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Contrato" name="Comprobar contrato vigente">
      <bpmn:incoming>F_01</bpmn:incoming>
      <bpmn:outgoing>F_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Datos" name="Recuperar horas y datos del contrato">
      <bpmn:incoming>F_02</bpmn:incoming>
      <bpmn:incoming>F_05</bpmn:incoming>
      <bpmn:outgoing>F_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Datos" name="¿Datos completos?">
      <bpmn:incoming>F_03</bpmn:incoming>
      <bpmn:outgoing>F_04</bpmn:outgoing>
      <bpmn:outgoing>F_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Corregir" name="Corregir información">
      <bpmn:incoming>F_04</bpmn:incoming>
      <bpmn:outgoing>F_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Revisar" name="Revisar borrador de factura">
      <bpmn:incoming>F_06</bpmn:incoming>
      <bpmn:incoming>F_09</bpmn:incoming>
      <bpmn:outgoing>F_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Revisar" name="¿Aprobado?">
      <bpmn:incoming>F_07</bpmn:incoming>
      <bpmn:outgoing>F_08</bpmn:outgoing>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Ajustar" name="Ajustar condiciones">
      <bpmn:incoming>F_08</bpmn:incoming>
      <bpmn:outgoing>F_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Arca" name="Solicitar autorización electrónica">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Arca" name="¿Autorizado?">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Rechazo" name="Analizar rechazo fiscal">
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Rechazo" name="Emisión pendiente">
      <bpmn:incoming>F_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_RegistrarFactura" name="Guardar factura y vencimiento">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="I_Cobro" name="Aviso de cobro">
      <bpmn:messageEventDefinition id="MsgEvent_I_Cobro"/>
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_ValidarCobro" name="Validar cobro e importe">
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Cobro" name="¿Cobro válido?">
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Diferencia" name="Consultar diferencia con el cliente">
      <bpmn:incoming>F_18</bpmn:incoming>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Saldo" name="Aplicar cobro y actualizar saldo">
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Fin" name="Saldo actualizado">
      <bpmn:incoming>F_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_01" sourceRef="S_Inicio" targetRef="T_Contrato"/>
    <bpmn:sequenceFlow id="F_02" sourceRef="T_Contrato" targetRef="T_Datos"/>
    <bpmn:sequenceFlow id="F_03" sourceRef="T_Datos" targetRef="G_Datos"/>
    <bpmn:sequenceFlow id="F_04" sourceRef="G_Datos" targetRef="T_Corregir" name="No"/>
    <bpmn:sequenceFlow id="F_05" sourceRef="T_Corregir" targetRef="T_Datos"/>
    <bpmn:sequenceFlow id="F_06" sourceRef="G_Datos" targetRef="T_Revisar" name="Sí"/>
    <bpmn:sequenceFlow id="F_07" sourceRef="T_Revisar" targetRef="G_Revisar"/>
    <bpmn:sequenceFlow id="F_08" sourceRef="G_Revisar" targetRef="T_Ajustar" name="No"/>
    <bpmn:sequenceFlow id="F_09" sourceRef="T_Ajustar" targetRef="T_Revisar"/>
    <bpmn:sequenceFlow id="F_10" sourceRef="G_Revisar" targetRef="T_Arca" name="Sí"/>
    <bpmn:sequenceFlow id="F_11" sourceRef="T_Arca" targetRef="G_Arca"/>
    <bpmn:sequenceFlow id="F_12" sourceRef="G_Arca" targetRef="T_Rechazo" name="No"/>
    <bpmn:sequenceFlow id="F_13" sourceRef="T_Rechazo" targetRef="E_Rechazo"/>
    <bpmn:sequenceFlow id="F_14" sourceRef="G_Arca" targetRef="T_RegistrarFactura" name="Sí"/>
    <bpmn:sequenceFlow id="F_15" sourceRef="T_RegistrarFactura" targetRef="I_Cobro"/>
    <bpmn:sequenceFlow id="F_16" sourceRef="I_Cobro" targetRef="T_ValidarCobro"/>
    <bpmn:sequenceFlow id="F_17" sourceRef="T_ValidarCobro" targetRef="G_Cobro"/>
    <bpmn:sequenceFlow id="F_18" sourceRef="G_Cobro" targetRef="T_Diferencia" name="No"/>
    <bpmn:sequenceFlow id="F_19" sourceRef="T_Diferencia" targetRef="T_ValidarCobro"/>
    <bpmn:sequenceFlow id="F_20" sourceRef="G_Cobro" targetRef="T_Saldo" name="Sí"/>
    <bpmn:sequenceFlow id="F_21" sourceRef="T_Saldo" targetRef="E_Fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_facturacion_cobranzas">
    <bpmndi:BPMNPlane id="Plane_facturacion_cobranzas" bpmnElement="Collaboration_facturacion_cobranzas">
